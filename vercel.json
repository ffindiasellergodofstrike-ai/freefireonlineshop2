{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/payments/easebuzz/reconcile-cron", "schedule": "0 3 * * *" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
