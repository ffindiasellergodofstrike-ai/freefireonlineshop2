# Public canonical checkout/callback domain (HTTPS in production).
APP_URL=https://www.ffdigital.shop

# Firebase Realtime Database
FIREBASE_DATABASE_URL="https://freefireshop-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_DATABASE_AUTH=
# Keep the existing private server-side REST credential in Vercel.
# FIREBASE_DATABASE_SECRET is supported as an alternative variable name.
# Production orders and accounts require authenticated REST access.
FIREBASE_STORAGE_BUCKET=

# Private product ZIP source. A complete MEGA file link (including its #key) or
# a direct HTTPS object-storage URL is supported. Keep it only in Vercel.
# Product id "linknest-pro" maps to PRODUCT_DOWNLOAD_URL_LINKNEST_PRO.
PRODUCT_DOWNLOAD_URL_LINKNEST_PRO=
PRODUCT_DOWNLOAD_URL_NEURA_AI=
PRODUCT_DOWNLOAD_URL_FINORA=
PRODUCT_DOWNLOAD_URL_LEARNIFY=
PRODUCT_DOWNLOAD_URL_VELORA=
PRODUCT_DOWNLOAD_URL_WORKHUB=

# Easebuzz Payment Gateway (India)
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test # test | prod

# Cron / Reconcile Secret
CRON_SECRET=

# Resend purchase confirmation email. The sender must belong to a domain that
# is verified in Resend. Keep the API key only in Vercel environment variables.
RESEND_API_KEY=
RESEND_FROM_EMAIL="FFDigital <orders@ffdigital.shop>"

# One-time email download links expire after this many hours (1-720).
PURCHASE_EMAIL_LINK_TTL_HOURS=168

# Details printed on the attached PDF invoice.
INVOICE_BUSINESS_NAME="FFDigital"
INVOICE_BUSINESS_ADDRESS=
INVOICE_GSTIN=
INVOICE_SUPPORT_EMAIL=
