# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# Firebase Realtime Database
FIREBASE_DATABASE_URL="https://vexora-724fc-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_DATABASE_AUTH=
FIREBASE_STORAGE_BUCKET=

# Private product ZIP source. Upload the ZIP to Firebase Storage (or another
# HTTPS object store) and keep this signed URL in Vercel Environment Variables.
# Product id "linknest-pro" maps to PRODUCT_DOWNLOAD_URL_LINKNEST_PRO.
PRODUCT_DOWNLOAD_URL_LINKNEST_PRO=

# Easebuzz Payment Gateway (India)
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test # test | prod

# Cron / Reconcile Secret
CRON_SECRET=
